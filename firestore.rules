rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Test connection probe allowed for app verification
    match /test/connection {
      allow read: if true;
    }

    // User profile document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().uid == request.auth.uid
        && incoming().email is string
        && incoming().email.size() <= 128
        && incoming().name is string
        && incoming().name.size() <= 128;

      allow update: if isOwner(userId)
        && incoming().uid == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasAny([
          'name', 'username', 'photoURL', 'apsScore', 'prospectiveFaculty', 
          'targetProgram', 'documentsChecklist', 'updatedAt', 'lastActive'
        ]);

      allow delete: if isOwner(userId);

      // Subcollection: messages in user chat
      match /messages/{messageId} {
        allow get, list: if isOwner(userId);

        allow create: if isOwner(userId)
          && isValidId(messageId)
          && incoming().userId == request.auth.uid
          && incoming().sender in ['user', 'assistant', 'system']
          && incoming().text is string
          && incoming().text.size() <= 15000;

        allow update: if false;
        allow delete: if isOwner(userId);
      }
    }

    // Public/user feedback collection
    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow create: if isValidId(feedbackId)
        && incoming().isHelpful is bool
        && incoming().rating is number
        && incoming().rating >= 1 && incoming().rating <= 5;
      allow update, delete: if false;
    }
  }
}
